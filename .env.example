# Livelihood Intelligence Platform (PM-AJAY GIA) Configuration
# Environment Configuration Template for Local, Docker, and Remote Production

# ==============================================================================
# 1. Backend Server Configuration
# ==============================================================================
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
APP_NAME="Livelihood Intelligence Platform"
APP_VERSION="3.0.0"

# ==============================================================================
# 2. Database Configuration
# ==============================================================================
# Development / Testing (zero external dependencies):
# DATABASE_URL=sqlite:///./lip.db
#
# Docker Compose Local Stack:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/lip_db
#
# Remote Production Managed PostgreSQL (Supabase, Neon, AWS RDS, Render PG):
# DATABASE_URL=postgresql://user:password@hostname:5432/database_name?sslmode=require
# (Note: URLs starting with postgres:// are automatically normalized to postgresql://)
DATABASE_URL=sqlite:///./lip.db

# ==============================================================================
# 3. Security, Authentication & CORS
# ==============================================================================
# MANDATORY IN PRODUCTION: 32+ character random string
SECRET_KEY=development-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Allowed CORS origins. Accepts comma-separated list OR JSON array string:
# Examples:
#   ALLOWED_ORIGINS=http://localhost:3000,https://web-lip.vercel.app
#   ALLOWED_ORIGINS=["http://localhost:3000","https://web-lip.vercel.app"]
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000

# ==============================================================================
# 4. Frontend Configuration (apps/web)
# ==============================================================================
# URL pointing to the deployed FastAPI backend:
# Local development / Docker Compose: http://localhost:8000
# Production deployment: https://api.yourdomain.gov.in
NEXT_PUBLIC_API_URL=http://localhost:8000

# ==============================================================================
# 5. Truth States & Evaluation Flags
# ==============================================================================
# DEMO_MODE=true enables role switching (/api/v1/identity/demo/switch-role) and demo personas.
# DEMO_MODE=false enforces production-only mode (returns 404 on role switch, disables demo fixtures).
DEMO_MODE=true
ENABLE_MOCK_TELEPHONY=true
ENABLE_MOCK_SPEECH=true

# ==============================================================================
# 6. Speech & AI Gateway Config (Optional External Providers)
# ==============================================================================
# AI_PROVIDER: deterministic, deepseek, qwen, openai, gemini
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=
SARVAM_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==============================================================================
# 7. Storage
# ==============================================================================
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage

