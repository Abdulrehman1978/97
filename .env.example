# Livelihood Intelligence Platform (PM-AJAY GIA) Configuration
# Environment Configuration Template

# Server Configuration
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
APP_NAME="Livelihood Intelligence Platform"
APP_VERSION="3.0.0"

# Database Configuration
# In development/test, SQLite can be used for zero-dependency execution.
# For production PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/lip_db
DATABASE_URL=sqlite+aiosqlite:///./lip.db
DATABASE_SYNC_URL=sqlite:///./lip.db

# Security & Authentication
SECRET_KEY=development-insecure-secret-key-change-in-production-min-32-chars
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# Truth States & Demo Flags
DEMO_MODE=true
ENABLE_MOCK_TELEPHONY=true
ENABLE_MOCK_SPEECH=true

# Speech & AI Gateway Config (Optional External Providers)
AI_PROVIDER=deterministic
AI_API_KEY=
AI_MODEL=
SARVAM_API_KEY=
BHASHINI_API_KEY=
BHASHINI_USER_ID=
BHASHINI_PIPELINE_ID=
GEMINI_API_KEY=
OPENAI_API_KEY=

# Storage (Local Directory or S3)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=./data/storage
